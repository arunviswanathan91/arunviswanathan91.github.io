# Browser-safe values (GitHub repository variables or local .env)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server-only Supabase Edge Function secrets — never prefix with VITE_
SUPABASE_SERVICE_ROLE_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
# Shared secret checked by telegram-reminder-sweep; only pg_cron should call it, with this
# header value. Store it in Supabase Vault and reference it from the cron job body.
CRON_SWEEP_SECRET=
