# Same Supabase project as ../dashboard-app/. The service role key bypasses Row
# Level Security entirely -- never commit it, never expose it client-side.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional: your user id. Auto-detected from discovery_profiles/profiles if unset.
DISCOVERY_USER_ID=

# Free at https://developer.adzuna.com -- ~1000 calls/month.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Free key at https://jooble.org/api/about
JOOBLE_API_KEY=

# Same bot token the dashboard's telegram-webhook Edge Function uses, only
# needed here to push the nightly digest.
TELEGRAM_BOT_TOKEN=

# Reserved for Phase 3 (LLM fallback extraction) -- not read yet.
GROQ_API_KEY=
GEMINI_API_KEY=
